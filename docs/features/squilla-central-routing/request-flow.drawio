                </mxCell>
                <mxCell id="fallback" value="tier = profile.defaultTier&#xa;（唯一兜底：一个常量，不是本地猜测）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
