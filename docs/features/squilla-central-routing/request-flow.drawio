                <mxCell id="c_embed" value="① 390维特征装配（BGE-ONNX 进程内 · CPU）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="650" y="430" width="280" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c_classify" value="② V4 集成：LGBM+MLP → 概率融合 → 后处理&#xa;→ route_class(R0-R3) → tier + margin/difficulty/flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="650" y="480" width="280" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="note_degrade" value="V4 不可用 →&#xa;无依赖 band 启发式（照常 snap/粘滞/落库）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="950" y="480" width="185" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c_bias" value="③ 选规则 + 跑两遍尾部链（plan_tier）&#xa;baseline=无规则 · proposed=带规则（weights 位移 → clamp 收窄候选集）&#xa;dryRun 服务 baseline；tainted = 服务档 ≠ baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="650" y="545" width="280" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="c_snap" value="④ snap：只从 clamp 后的候选集里挑&#xa;缺档向上，不静默降级（floor/ceiling 因此逃不掉）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="650" y="608" width="280" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="c_sticky" value="⑤ apply_sticky：短续轮不得低于上一轮档位（保 KV-cache）&#xa;上一轮档位同样先 clamp，粘滞不能按住越界的档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="650" y="671" width="280" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="db_last" value="store.last_tier(tenant, session)&#xa;decisions 最新 final_tier（idx_decisions_session）&#xa;— 多实例 / 重启均正确" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
